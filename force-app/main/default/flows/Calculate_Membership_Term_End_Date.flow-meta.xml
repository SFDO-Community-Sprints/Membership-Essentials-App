    <description>Shared, read-only membership term calculation. Callers choose ReferenceDate. Reads MembershipEssentialsDefaults by DeveloperName; missing or blank settings use Day before anniversary. Invalid inputs return IsValid=false and ErrorMessage without calculating a date. Callers own logging and marking their MFS Failed. Month-end behavior follows Salesforce ADDMONTHS.</description>
    <environments>Default</environments>
    <formulas>
        <name>ConfiguredEndDate</name>
        <dataType>Date</dataType>
        <expression>CASE({!TermUnit}, &quot;Year&quot;, ADDMONTHS({!ReferenceDate}, 12 * {!Term}), &quot;Month&quot;, ADDMONTHS({!ReferenceDate}, {!Term}), &quot;Week&quot;, {!ReferenceDate} + 7 * {!Term}, &quot;Day&quot;, {!ReferenceDate} + {!Term}, NULL) - IF(TEXT({!Get_Default_Settings.Term_End_Convention__c}) = &quot;Anniversary&quot;, 0, 1)</expression>
    </formulas>
    <formulas>
        <name>InputsAreValid</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!ReferenceDate})), NOT(ISBLANK({!Term})), {!Term} &gt; 0, MOD({!Term}, 1) = 0, OR({!TermUnit} = &quot;Day&quot;, {!TermUnit} = &quot;Week&quot;, {!TermUnit} = &quot;Month&quot;, {!TermUnit} = &quot;Year&quot;))</expression>
    </formulas>
    <formulas>
        <name>InvalidInputMessage</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!ReferenceDate}), &quot;A reference date is required to calculate the membership term.&quot;, IF(OR(ISBLANK({!Term}), {!Term} &lt;= 0, MOD({!Term}, 1) &lt;&gt; 0), &quot;The membership product term must be a positive whole number.&quot;, &quot;The membership product term unit must be Day, Week, Month, or Year.&quot;))</expression>
    </formulas>
    <formulas>
        <name>TermFitsDateRange</name>
        <dataType>Boolean</dataType>
        <expression>{!Term} &lt;= CASE({!TermUnit}, &quot;Year&quot;, 9999 - YEAR({!ReferenceDate}), &quot;Month&quot;, (9999 - YEAR({!ReferenceDate})) * 12 + 12 - MONTH({!ReferenceDate}), &quot;Week&quot;, FLOOR((DATE(9999, 12, 31) - {!ReferenceDate}) / 7), &quot;Day&quot;, DATE(9999, 12, 31) - {!ReferenceDate}, 0)</expression>
    </formulas>
    <interviewLabel>Calculate Membership Term End Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Calculate Membership Term End Date</label>
